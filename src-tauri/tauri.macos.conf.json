{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Notetaker",
        "width": 1180,
        "height": 800,
        "minWidth": 500,
        "minHeight": 480,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "macOS": {
      "frameworks": [
        "target/release/libonnxruntime.1.17.1.dylib",
        "target/release/libsherpa-onnx-c-api.dylib",
        "target/release/libsherpa-onnx-cxx-api.dylib"
      ],
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Notetaker Local Signing",
      "entitlements": "entitlements.plist"
    }
  }
}
